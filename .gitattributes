# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# C source and headers
*.c text diff=cpp
*.h text diff=cpp
*.S text diff=cpp
*.asm text

# Build files and shell scripts
Makefile text eol=lf
*.mk text eol=lf
*.sh text eol=lf

# Documentation and markdown
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.img binary
*.bin binary
*.o binary
*.out binary
